{
  "name": "conecta-social-api",
  "version": "1.0.0-alpha.1",
  "description": "API Modular (IAM, Notifications, Social) utilizando Clean Architecture e Hono.",
  "type": "module",
  "main": "src/index.ts",
  "modules_version": {
    "iam": "1.0.0-alpha",
    "notifications": "1.0.0-alpha",
    "social": "0.0.0-legacy",
    "shared": "1.0.0-alpha"
  },
  "workspaces": [
    "src/modules/*"
  ],
  "catalog": {
    "@sendgrid/mail": "^8.1.3",
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.2.3",
    "hono": "^4.11.4",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.1.3",
    "resend": "^6.7.0",
    "swagger-jsdoc": "^6.2.8",
    "zod": "^4.3.5",
    "@types/bun": "^1.3.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^25.0.9",
    "@types/swagger-jsdoc": "^6.0.4",
    "typescript": "^5.2.2"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "dev:hot": "bun --hot src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test",
    "migrate:iam": "bun src/modules/shared/infra/postgres/migrations/iam.migration.ts",
    "migrate:notifications": "bun src/modules/shared/infra/postgres/migrations/notification.migration.ts",
    "seed:iam": "bun src/modules/shared/infra/postgres/migrations/seed.migration.ts",
    "docker:up": "docker-compose up -d --build",
    "maturity:check": "gemini -c context_files/ --prompt prompt_maturidade.txt > handbook/reports/DATA_MATURITY_REPORT.md"
  },
  "keywords": [
    "clean-architecture",
    "iam",
    "notifications",
    "hono",
    "bun"
  ],
  "author": "Conecta Social Team",
  "license": "ISC",
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/jsonwebtoken": "catalog:",
    "@types/node": "catalog:",
    "@types/swagger-jsdoc": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@sendgrid/mail": "catalog:",
    "@types/bcrypt": "catalog:",
    "bcrypt": "catalog:",
    "dotenv": "catalog:",
    "hono": "catalog:",
    "hono-zod-openapi": "^1.0.1",
    "jsonwebtoken": "catalog:",
    "mongoose": "catalog:",
    "resend": "catalog:",
    "swagger-jsdoc": "catalog:",
    "zod": "catalog:"
  }
}