{
  "name": "conecta-social-api",
  "version": "1.0.0-beta.1",
  "description": "API Modular (IAM, Notifications, Social) utilizando Clean Architecture e Bun Native.",
  "type": "module",
  "main": "src/server-bun.ts",
  "workspaces": [
    "src/modules/*"
  ],
  "scripts": {
    "start": "bun src/server-bun.ts",
    "dev": "bun --watch src/server-bun.ts",
    "test": "bun test",
    
    "db:migrate": "bun src/modules/shared/infra/postgres/migrations/iam.migration.ts && bun src/modules/shared/infra/postgres/migrations/notification.migration.ts",
    "db:seed": "bun src/modules/shared/infra/postgres/migrations/seed.migration.ts",
    "db:setup": "bun run db:migrate && bun run db:seed",
    
    "docker:up": "docker-compose up -d --build",
    
    "legacy:start": "bun src/index.ts",
    "legacy:dev": "bun --watch src/index.ts"
  },
  "keywords": [
    "clean-architecture",
    "iam",
    "notifications",
    "bun",
    "native"
  ],
  "author": "Conecta Social Team",
  "license": "ISC",
  "dependencies": {
    "zod": "^3.22.4",
    "resend": "^3.2.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "hono": "^4.0.0" 
  }
}
