{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowJs": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@modules/iam/*": ["./src/modules/iam/*"],
      "@modules/notifications/*": ["./src/modules/notifications/*"],
      "@modules/shared/*": ["./src/modules/shared/*"],
      "*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "bunfig.toml", "package.json"],
  "exclude": ["node_modules", "**/*.spec.ts"]
}