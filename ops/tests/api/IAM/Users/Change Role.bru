meta {
  name: Change Role
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/users/{{created_user_id}}/role
  body: json
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

body:json {
  {
    "newRoleId": "{{created_role_id}}"
  }
}

assert {
  res.status: eq 200
  res.body.roleId: eq {{created_role_id}}
}