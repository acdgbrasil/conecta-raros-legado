meta {
  name: Create User
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/users
  body: json
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

body:json {
  {
    "name": "Test User Bruno",
    "email": "bruno.test@conecta.com",
    "password": "Password123!",
    "role": "USER"
  }
}

assert {
  res.status: eq 201
  res.body.id: isString
}

script:post-response {
  bru.setEnvVar("created_user_id", res.body.id);
}
