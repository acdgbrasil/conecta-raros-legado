meta {
  name: Create Role
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/roles
  body: json
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

body:json {
  {
    "name": "Financeiro",
    "description": "Acesso aos relatórios financeiros",
    "permissionIds": [
      "users:read",
      "users:status"
    ]
  }
}

assert {
  res.status: eq 201
  res.body.id: isString
  res.body.name: eq Financeiro
}

script:post-response {
  bru.setEnvVar("created_role_id", res.body.id);
}
