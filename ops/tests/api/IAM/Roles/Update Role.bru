meta {
  name: Update Role
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/roles/{{created_role_id}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

body:json {
  {
    "description": "Descrição Atualizada via Bruno"
  }
}

assert {
  res.status: eq 200
  res.body.description: eq Descrição Atualizada via Bruno
}
