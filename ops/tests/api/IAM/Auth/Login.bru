meta {
  name: Login (Admin)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

assert {
  res.status: eq 200
  res.body.accessToken: isString
}

script:post-response {
  const body = res.getBody()
  bru.setVar("jwt_token",body.accessToken)
  bru.setVar("refresh_token",body.refreshToken)
}

tests {
  test("Deve retornar token JWT", function() {
    expect(res.body.accessToken).to.be.a('string');
  });
}
