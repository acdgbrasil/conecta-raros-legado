meta {
  name: Refresh Token
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/refresh
  body: json
  auth: none
}

body:json {
  {
    "refreshToken": "{{refresh_token}}"
  }
}

assert {
  res.status: eq 200
  res.body.accessToken: isString
}

tests {
  test("Deve retornar novo token", function() {
    expect(res.body.accessToken).to.not.equal(bru.getEnvVar("jwt_token"));
  });
}
