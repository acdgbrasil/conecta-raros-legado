meta {
  name: Reset Password
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/auth/reset-password
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "code": "{{reset_code}}",
    "newPassword": "{{new_password}}"
  }
}

assert {
  res.status: eq 200
  res.body.message: eq "Senha redefinida com sucesso."
}

script:post-response {
  if (res.status !== 200) {
    console.log("❌ Erro no Reset Password:", JSON.stringify(res.body, null, 2));
  }
}

tests {
  test("Deve redefinir a senha com sucesso", function() {
    expect(res.status).to.equal(200);
    expect(res.body.message).to.equal("Senha redefinida com sucesso.");
  });
}
